{
  "_comment": "四信用传装置父设备物模型 (基于GB/T 26875.3-2011 + 四信私有扩展)",
  "properties": [
    { "identifier": "seq_no", "name": "业务流水号", "dataType": { "type": "int32", "specs": { "min": 0, "max": 65535 } }, "accessMode": "r", "description": "报文业务流水号，每报文递增" },
    { "identifier": "cmd_byte", "name": "命令字节", "dataType": { "type": "enum", "specs": { "1": "控制命令", "2": "发送数据", "3": "确认", "4": "请求", "5": "应答", "6": "否认" } }, "accessMode": "r" },
    { "identifier": "packet_time", "name": "报文时间", "dataType": { "type": "date" }, "accessMode": "r" },
    { "identifier": "last_fire_alarm", "name": "最新火警状态", "dataType": { "type": "enum", "specs": { "0": "正常", "1": "火警" } }, "accessMode": "r" },
    { "identifier": "last_fault", "name": "最新故障状态", "dataType": { "type": "enum", "specs": { "0": "正常", "1": "故障" } }, "accessMode": "r" },
    { "identifier": "comp_fire_count", "name": "部件火警数量", "dataType": { "type": "int32", "specs": { "min": 0 } }, "accessMode": "r" },
    { "identifier": "last_temperature", "name": "最新温度值", "dataType": { "type": "float", "specs": { "min": -100, "max": 500, "unit": "℃" } }, "accessMode": "r" },
    { "identifier": "last_pressure", "name": "最新压力值", "dataType": { "type": "float", "specs": { "min": 0, "max": 100, "unit": "MPa" } }, "accessMode": "r" },
    { "identifier": "dev_normal_monitor", "name": "运行模式", "dataType": { "type": "enum", "specs": { "0": "测试", "1": "正常" } }, "accessMode": "r" },
    { "identifier": "dev_fire_alarm", "name": "装置火警", "dataType": { "type": "enum", "specs": { "0": "无火警", "1": "火警" } }, "accessMode": "r", "description": "核心告警属性，用于规则引擎订阅" },
    { "identifier": "dev_fault", "name": "装置故障", "dataType": { "type": "enum", "specs": { "0": "无故障", "1": "故障" } }, "accessMode": "r" },
    { "identifier": "dev_main_power_fault", "name": "主电状态", "dataType": { "type": "enum", "specs": { "0": "主电正常", "1": "主电故障" } }, "accessMode": "r" },
    { "identifier": "dev_backup_power_fault", "name": "备电状态", "dataType": { "type": "enum", "specs": { "0": "备电正常", "1": "备电故障" } }, "accessMode": "r" },
    { "identifier": "dev_comm_fault", "name": "通信状态", "dataType": { "type": "enum", "specs": { "0": "通信正常", "1": "通信故障" } }, "accessMode": "r" },
    { "identifier": "dev_line_fault", "name": "监测线路状态", "dataType": { "type": "enum", "specs": { "0": "线路正常", "1": "线路故障" } }, "accessMode": "r" },
    { "identifier": "dev_status_raw", "name": "装置状态原始值", "dataType": { "type": "int32", "specs": { "min": 0, "max": 255 } }, "accessMode": "r" },
    { "identifier": "dev_status_time", "name": "装置状态时间", "dataType": { "type": "date" }, "accessMode": "r" },
    { "identifier": "dev_main_ver", "name": "装置主版本", "dataType": { "type": "int32", "specs": { "min": 0, "max": 255 } }, "accessMode": "r" },
    { "identifier": "dev_sub_ver", "name": "装置次版本", "dataType": { "type": "int32", "specs": { "min": 0, "max": 255 } }, "accessMode": "r" },
    { "identifier": "dev_config_desc", "name": "装置配置描述", "dataType": { "type": "text" }, "accessMode": "r" },
    { "identifier": "device_time", "name": "装置系统时间", "dataType": { "type": "date" }, "accessMode": "r" },
    { "identifier": "prt_last_update", "name": "PRT最近更新时间", "dataType": { "type": "date" }, "accessMode": "r", "description": "四信私有：最近一次PRT点位表上报时间" },
    { "identifier": "crt_last_update", "name": "CRT最近更新时间", "dataType": { "type": "date" }, "accessMode": "r", "description": "四信私有：最近一次CRT部件数据上报时间" },
    { "identifier": "remote_control_status", "name": "远程控制状态", "dataType": { "type": "enum", "specs": { "0": "空闲", "1": "执行中", "2": "成功", "3": "失败", "4": "超时" } }, "accessMode": "r", "description": "四信私有：remote_control服务执行状态" }
  ],
  "events": [
    { "identifier": "fire_alarm_event", "name": "火灾报警事件", "outputData": [
      { "identifier": "event_level", "name": "事件级别", "dataType": { "type": "enum", "specs": { "1": "系统级", "2": "部件级", "3": "装置级" } } },
      { "identifier": "event_sys_type", "name": "系统类型", "dataType": { "type": "int32" } },
      { "identifier": "event_sys_addr", "name": "系统地址", "dataType": { "type": "int32" } },
      { "identifier": "event_comp_type", "name": "部件类型", "dataType": { "type": "int32" } },
      { "identifier": "event_comp_addr", "name": "部件地址", "dataType": { "type": "text" } },
      { "identifier": "event_time", "name": "事件时间", "dataType": { "type": "date" } },
      { "identifier": "event_desc", "name": "事件描述", "dataType": { "type": "text" } }
    ]},
    { "identifier": "fault_event", "name": "故障告警事件", "outputData": [
      { "identifier": "fault_type", "name": "故障类型", "dataType": { "type": "enum", "specs": { "1": "主电故障", "2": "备电故障", "5": "总线故障", "6": "系统/装置故障", "7": "部件故障" } } },
      { "identifier": "fault_sys_type", "name": "系统类型", "dataType": { "type": "int32" } },
      { "identifier": "fault_sys_addr", "name": "系统地址", "dataType": { "type": "int32" } },
      { "identifier": "event_time", "name": "事件时间", "dataType": { "type": "date" } },
      { "identifier": "event_desc", "name": "事件描述", "dataType": { "type": "text" } }
    ]},
    { "identifier": "power_fault_event", "name": "电源故障事件", "outputData": [
      { "identifier": "power_type", "name": "电源类型", "dataType": { "type": "enum", "specs": { "1": "主电", "2": "备电", "3": "部件电源" } } },
      { "identifier": "source_type", "name": "来源类型", "dataType": { "type": "enum", "specs": { "1": "系统", "2": "部件", "21": "装置" } } },
      { "identifier": "event_time", "name": "事件时间", "dataType": { "type": "date" } }
    ]},
    { "identifier": "prt_alarm_event", "name": "PRT打印报警事件", "outputData": [
      { "identifier": "alarm_type", "name": "报警类型", "dataType": { "type": "int32" } },
      { "identifier": "device_name", "name": "设备名称", "dataType": { "type": "text" } },
      { "identifier": "location", "name": "设备位置", "dataType": { "type": "text" } },
      { "identifier": "alarm_info", "name": "报警信息", "dataType": { "type": "text" } },
      { "identifier": "event_time", "name": "事件时间", "dataType": { "type": "date" } }
    ]},
    { "identifier": "crt_alarm_event", "name": "CRT图形报警事件", "outputData": [
      { "identifier": "alarm_type", "name": "报警类型码", "dataType": { "type": "int32" } },
      { "identifier": "alarm_type_desc", "name": "报警类型描述", "dataType": { "type": "text" } },
      { "identifier": "event_json", "name": "事件字段列表", "dataType": { "type": "array" } },
      { "identifier": "event_time", "name": "事件时间", "dataType": { "type": "date" } },
      { "identifier": "source", "name": "来源标识", "dataType": { "type": "text" } },
      { "identifier": "linked_device_name", "name": "关联子设备", "dataType": { "type": "text" } }
    ]},
    { "identifier": "offline_event", "name": "装置离线事件", "outputData": [
      { "identifier": "last_seen", "name": "最后在线时间", "dataType": { "type": "date" } },
      { "identifier": "offline_time", "name": "离线时间", "dataType": { "type": "date" } }
    ]}
  ],
  "services": [
    { "identifier": "sync_device_time", "name": "同步时钟", "inputData": [{ "identifier": "target_time", "name": "目标时间", "dataType": { "type": "date" }, "required": true }], "outputData": [{ "identifier": "success", "name": "是否成功", "dataType": { "type": "enum", "specs": { "0": "失败", "1": "成功" } } }] },
    { "identifier": "inspection_cmd", "name": "查岗命令", "inputData": [{ "identifier": "timeout_min", "name": "超时分钟", "dataType": { "type": "int32", "specs": { "min": 1, "max": 60 } }, "required": false }], "outputData": [{ "identifier": "responded", "name": "是否响应", "dataType": { "type": "enum", "specs": { "0": "未响应", "1": "已响应" } } }] },
    { "identifier": "init_device", "name": "初始化装置", "inputData": [], "outputData": [{ "identifier": "success", "name": "是否成功", "dataType": { "type": "enum", "specs": { "0": "失败", "1": "成功" } } }] },
    { "identifier": "read_system_status", "name": "读系统状态", "inputData": [
      { "identifier": "query_sys_type", "name": "系统类型", "dataType": { "type": "int32" }, "required": true },
      { "identifier": "query_sys_addr", "name": "系统地址", "dataType": { "type": "int32" }, "required": true }
    ], "outputData": [{ "identifier": "result_json", "name": "查询结果", "dataType": { "type": "text" } }] },
    { "identifier": "read_component_status", "name": "读部件状态", "inputData": [
      { "identifier": "query_sys_type", "name": "系统类型", "dataType": { "type": "int32" }, "required": true },
      { "identifier": "query_comp_addr", "name": "部件地址", "dataType": { "type": "text" }, "required": true }
    ], "outputData": [{ "identifier": "result_json", "name": "查询结果", "dataType": { "type": "text" } }] },
    { "identifier": "remote_control", "name": "远程控制", "inputData": [
      { "identifier": "control_type", "name": "控制类型", "dataType": { "type": "enum", "specs": { "10": "复位", "20": "消音", "30": "开关", "40": "总线开关", "41": "多线开关" } }, "required": true },
      { "identifier": "host_no", "name": "主机号", "dataType": { "type": "text" }, "required": true },
      { "identifier": "circuit_no", "name": "回路号", "dataType": { "type": "text" }, "required": true },
      { "identifier": "address_no", "name": "地址号", "dataType": { "type": "text" }, "required": true }
    ], "outputData": [
      { "identifier": "success", "name": "是否成功", "dataType": { "type": "enum", "specs": { "0": "失败", "1": "成功" } } },
      { "identifier": "command_code", "name": "指令码", "dataType": { "type": "text" } },
      { "identifier": "error_msg", "name": "错误信息", "dataType": { "type": "text" } }
    ] }
  ]
}
