            // 调用 POST 接口
            String url = "https://**:443/evo-apigw/evo-oauth/1.0.0/oauth/extend/refresh/token";
            ResponseEntity<String> response = getRestTemplate().exchange(url, HttpMethod.POST, entity, String.class);
